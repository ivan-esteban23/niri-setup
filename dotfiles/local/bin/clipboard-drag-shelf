#!/usr/bin/env python3
"""
Floating Clipboard & File Drag-and-Drop Shelf for Alacritty (`agy` & `opencode`),
Brave Origin, and Niri.

Features:
- Opens as a compact floating window (app-id: com.danklinux.drag-shelf) over Alacritty
- Materializes clipboard history images & text into real files in ~/.cache/clipboard-drag-shelf/
  so even in-memory screenshots/clipboard images can be dragged with the mouse as real files
  directly into Alacritty (`agy` / `opencode`)!
- Provides 3 tabs:
  1. "🕒 Clipboard" (Live clipboard history: images with thumbnails, copied files, and text)
  2. "🖼️ Pictures" (Files in ~/Pictures with live thumbnails)
  3. "📂 Vault & Docs" (Files in ~/Obsidian Vault, ~/Documents, plus any pinned files)
- Every card is a native Wayland Gtk.DragSource offering `text/uri-list`, `text/plain`,
  and `Gdk.FileList` AND automatically loads image pixels to the clipboard on drag start!
"""

import base64
import datetime
import json
import os
import subprocess
import sys
import urllib.parse
from pathlib import Path

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gdk", "4.0")
gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gdk, GdkPixbuf, Gio, GLib, Gtk, Pango

SHELF_CACHE = Path.home() / ".cache" / "clipboard-drag-shelf"
PINNED_FILE = SHELF_CACHE / "pinned_files.json"
HELPER_BIN = str(Path.home() / ".local" / "bin" / "clip-attach-helper")

IMAGE_EXTS = {
    ".png", ".jpg", ".jpeg", ".webp", ".gif", ".bmp", ".svg", ".tiff", ".tif", ".ico", ".avif"
}

DANK_CSS = """
