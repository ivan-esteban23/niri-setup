#!/usr/bin/env python3
"""Read Google Calendar using gcalcli and maintain a private local agenda cache."""
import csv
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time
from urllib.parse import urlparse

CACHE = Path(os.environ.get('XDG_CACHE_HOME') or Path.home() / '.cache') / 'niri-gcal'
CONFIG = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'niri-gcal' / 'config.json'

def read(path, default):
    try:
        with path.open(encoding='utf-8') as stream: return json.load(stream)
    except (OSError, ValueError): return default

def save(path, value):
    fd, name = tempfile.mkstemp(dir=CACHE, prefix='.tmp-')
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as stream: json.dump(value, stream, ensure_ascii=False)
        os.replace(name, path)
    finally:
        if os.path.exists(name): os.unlink(name)

def safe_url(value):
    try:
        parsed = urlparse(value)
        return value if parsed.scheme == 'https' and parsed.hostname and not parsed.username and not parsed.password else ''
    except ValueError: return ''

def parse_events(text):
    events = []
    for row in csv.DictReader(text.splitlines(keepends=True), delimiter='\t'):
        if not row.get('start_date'): continue
        try:
            start = dt.datetime.fromisoformat(row['start_date'] + 'T' + (row.get('start_time') or '00:00')).astimezone()
            end = dt.datetime.fromisoformat((row.get('end_date') or row['start_date']) + 'T' + (row.get('end_time') or '00:00')).astimezone()
        except ValueError: continue
        events.append({'title': row.get('title') or '(no title)', 'start': int(start.timestamp()), 'end': int(end.timestamp()), 'allDay': not row.get('start_time'), 'meet': safe_url(row.get('conference_uri') or row.get('hangout_link') or ''), 'link': safe_url(row.get('html_link') or '')})
    return sorted(events, key=lambda event: event['start'])

def fetch(options, state):
    binary = shutil.which('gcalcli')
    if not binary:
        state.update(status='Install gcalcli and sign in to Google Calendar.', checked=int(time.time())); return state
    now = dt.datetime.now().astimezone()
    command = [binary, '--nocolor']
    for name in options.get('calendars', []):
        if isinstance(name, str) and name: command.extend(['--calendar', name])
    command += ['agenda', '--tsv', '--details', 'url', '--details', 'conference', now.strftime('%Y-%m-%dT%H:%M'), (now + dt.timedelta(days=3)).strftime('%Y-%m-%d')]
    try:
        result = subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60, env={**os.environ, 'NO_COLOR':'1'}, umask=0o077)
        if result.returncode: raise RuntimeError('Calendar sync failed. Run gcalcli init or check your connection.')
        state.update(status='Calendar synced', events=parse_events(result.stdout), updated=int(time.time()))
    except (OSError, subprocess.TimeoutExpired, RuntimeError):
        state['status'] = 'Calendar sync failed. Check gcalcli sign-in and connection.'
    state['checked'] = int(time.time())
    return state

def reminders(state):
    now = time.time()
    seen = {k:v for k,v in read(CACHE / 'reminded.json', {}).items() if isinstance(v, (int, float)) and v > now - 86400}
    for event in state.get('events', []):
        if event.get('allDay') or not 0 <= event['start'] - now <= 120: continue
        key = str(event['start']) + '|' + event['title'] + '|' + event.get('link','')
        if key in seen: continue
        try:
            sent = subprocess.run(['notify-send', '-a', 'Google Calendar', 'Starting soon', event['title']], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
            if sent.returncode == 0: seen[key] = now
        except (OSError, subprocess.TimeoutExpired): pass
    save(CACHE / 'reminded.json', seen)

def main():
    CACHE.mkdir(mode=0o700, parents=True, exist_ok=True)
    CACHE.chmod(0o700)
    with (CACHE / 'lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        state = read(CACHE / 'agenda.json', {'events': [], 'checked': 0})
        options = read(CONFIG, {})
        if not isinstance(options, dict): options = {}
        if not isinstance(options.get('calendars', []), list): options['calendars'] = []
        if '--refresh' in sys.argv or time.time() - state.get('checked', 0) >= 300:
            state = fetch(options, state)
            save(CACHE / 'agenda.json', state)
        reminders(state)
        print(json.dumps(state, ensure_ascii=False))

if __name__ == '__main__': main()
