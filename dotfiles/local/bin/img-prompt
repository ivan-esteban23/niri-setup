#!/usr/bin/env bash
# img-prompt — investigate an image with the Dux framework analysis,
# then build a ChatGPT image prompt from it (via Codex / ChatGPT).
# Subcommands: stage [file] | run | status
set -u

DIR="$HOME/.cache/img-prompt"
IMAGE="$DIR/staged-image.png"
ANALYSIS="$DIR/analysis.txt"
PROMPT="$DIR/prompt.txt"
STATE="$DIR/state.json"
LOG="$DIR/last-run.log"
LOCK="$DIR/lock"
TIMEOUT=900

mkdir -p "$DIR"

notify() { # $1 urgency, $2 title, $3 body
    command -v notify-send >/dev/null 2>&1 && \
        notify-send -u "$1" -a "Image Prompt" -i image "$2" "$3" 2>/dev/null &
    return 0
}

set_state() { # $1 phase, $2 detail
    printf '{"phase":"%s","detail":%s,"ts":%s}\n' \
        "$1" "${2:+\"$(printf '%s' "$2" | jq -Rs . | sed 's/"$//; s/^"//')\"}" \
        "$(date +%s)" > "$STATE" 2>/dev/null || \
        printf '{"phase":"%s","ts":%s}\n' "$1" "$(date +%s)" > "$STATE"
}

is_image() {
    file -b --mime-type "$1" 2>/dev/null | grep -q '^image/'
}

# --- stage ----------------------------------------------------------------------
# Attach the reference image: explicit path, or grab it from the clipboard.
cmd_stage() {
    local src="${1:-}"
    if [ -n "$src" ]; then
        if [ ! -f "$src" ] || ! is_image "$src"; then
            set_state "error" "Not an image: $src"
            notify critical "Image Prompt" "Not an image: $src"
            exit 1
        fi
        cp -f -- "$src" "$IMAGE"
    else
        if ! wl-paste -t image/png > "$IMAGE.tmp" 2>/dev/null || \
           ! is_image "$IMAGE.tmp" || [ ! -s "$IMAGE.tmp" ]; then
            rm -f "$IMAGE.tmp"
            set_state "error" "No image on clipboard — copy one first or give a path: img-prompt stage <file>"
            notify critical "Image Prompt" "No image on clipboard. Copy an image, or run: img-prompt stage <file>"
            exit 1
        fi
        mv -f "$IMAGE.tmp" "$IMAGE"
    fi
    set_state "staged" "$(du -h "$IMAGE" | cut -f1) image ready — Mod+Shift+G to build the prompt"
    notify normal "Image Prompt" "Reference attached: $(basename "$IMAGE")"
    echo "staged: $IMAGE"
}

# --- run ------------------------------------------------------------------------
cmd_run() {
    if [ ! -s "$IMAGE" ] || ! is_image "$IMAGE"; then
        set_state "error" "No reference attached — Mod+Shift+B stages one from the clipboard"
        notify critical "Image Prompt" "No reference attached. Copy an image and press Mod+Shift+B."
        exit 1
    fi
    if ! mkdir "$LOCK" 2>/dev/null; then
        set_state "busy" "already running"
        exit 0
    fi

    (
        trap 'rmdir "$LOCK" 2>/dev/null' EXIT
        exec > "$LOG" 2>&1
        FRAMEWORK_SAMPLE='Full-length candid street-style photograph of a young woman walking toward the camera on a city sidewalk at blue hour. She has long straight dark hair with blunt bangs and thin dark rectangular glasses, and wears a fitted black ribbed turtleneck crop top, a low-rise black belt with a silver buckle, and a dark washed asymmetric midi skirt with an uneven hem. She carries a leopard print tote bag and wears tall slouchy black boots. Off-center composition with a granular stone pillar on the left edge, leading lines from the curb, and blurred parked cars and traffic lights glowing green in the background. Soft overcast dusk lighting with cool blue-gray tones, muted palette of charcoal and slate with tan leopard accents. Eye-level, moderate depth of field, visible film grain, slightly faded blacks, nostalgic early-2000s street fashion aesthetic, 35mm film look.'

        INSTRUCTIONS="You are an expert fashion-photography prompt engineer. The attached image is the visual reference. Study it carefully, then produce TWO sections separated exactly by a line reading ### .

Section 1 — titled exactly: ## FRAMEWORK ANALYSIS
Reproduce the reference analysis style below (match its voice, density and category order — one flowing paragraph that proceeds: shot type and setting > subject appearance > body proportions > hairstyle > face/glasses > outfit pieces with precise garment details (fit, rise, wash, texture, hem) > accessories/bag/footwear > composition and framing devices > background elements > lighting > palette with accent colors > camera angle, lens feel, depth of field > film-aesthetic tokens). Reference analysis to imitate:

${FRAMEWORK_SAMPLE}

Section 2 — after the ### line, titled exactly: ## CHATGPT IMAGE PROMPT
A single dense paragraph (like the reference above) that could be pasted into ChatGPT to generate a NEW image in the exact style/outfit/composition/lighting of the reference. Describe the image itself as an instruction (not an analysis): start with the shot type, follow the same category order, keep every concrete garment/composition/lighting/film detail. Never mention that you analyzed an image or reference a source.

Output ONLY the two sections."

        set_state "analyzing" "Codex is reading the image…"
        notify normal "Image Prompt" "Analyzing reference with ChatGPT…"

        raw=$(printf '%s' "$INSTRUCTIONS" | timeout "$TIMEOUT" codex exec \
                --skip-git-repo-check \
                -s read-only \
                -i "$IMAGE" 2>&1)
        rc=$?
        out=$(printf '%s\n' "$raw" | awk '/^tokens used$/{once=1; next} once && /^[0-9]+\.[0-9]+$/{next} once')
        if [ $rc -ne 0 ]; then
            set_state "error" "ChatGPT analysis failed (code $rc) — see img-prompt log"
            notify critical "Image Prompt" "Analysis failed (exit $rc). Log: $LOG"
            exit 1
        fi

        # Codex exec wraps output with metadata lines; take everything after the
        # LAST occurrence of the framework header markers, tolerating variations.
        printf '%s\n' "$out" > "$DIR/raw-out.txt"

        # Extract sections on the ### separator
        awk 'BEGIN{s=1} /^### ?$|^#{3}\s*$/{s=2; next} /^## CHATGPT IMAGE PROMPT/{s=2; next} { if(s==1) print > "'"$ANALYSIS"'"; else if (s==2) print > "'"$PROMPT"'" }' "$DIR/raw-out.txt"

        if [ ! -s "$PROMPT" ]; then
            # fallback: treat entire tail as analysis and build prompt in pass 2
            cp "$DIR/raw-out.txt" "$ANALYSIS"
            set_state "analyzing" "building prompt pass…"
            out=$(printf 'Below is a framework analysis of a reference image. Convert it into ONE single-paragraph ChatGPT image-generation prompt in EXACTLY this style and density — describe the image as instructions, never as an analysis:\n\nREFERENCE STYLE:\n%s\n\nANALYSIS:\n%s\n\nOutput ONLY the prompt paragraph.' \
                "$FRAMEWORK_SAMPLE" "$(cat "$ANALYSIS")" | timeout "$TIMEOUT" codex exec \
                    --skip-git-repo-check \
                    -s read-only 2>&1) || {
                set_state "error" "Prompt build failed"; notify critical "Image Prompt" "Prompt build failed."; exit 1; }
            printf '%s\n' "$out" | awk '/^tokens used$/{once=1; next} once && /^[0-9]+\.[0-9]+$/{next} once' > "$PROMPT"
        fi

        # Clean: drop codex metadata headers if present
        sed -i '/^] codex$/d; /^] exec/d; /^\[20[0-9-]*T/d' "$PROMPT" "$ANALYSIS"
        # Keep the final paragraph(s) only: trim leading blank lines
        sed -i '/./,$!d' "$PROMPT"

        if [ -s "$PROMPT" ]; then
            wl-copy < "$PROMPT" 2>/dev/null || true
            set_state "done" "$(wc -c < "$PROMPT") chars copied to clipboard"
            notify normal "Image Prompt ready" "ChatGPT image prompt copied to your clipboard. Files: $PROMPT"
        else
            set_state "error" "Could not extract a prompt — check $LOG"
            notify critical "Image Prompt" "Extraction failed. Log: $LOG"
        fi
    ) &
    echo "started (pid $!)"
}

# --- status ---------------------------------------------------------------------
cmd_status() {
    if [ -f "$STATE" ]; then
        cat "$STATE"
    else
        echo '{"phase":"idle"}'
    fi
    [ -s "$IMAGE" ] && echo "image: $IMAGE ($(du -h "$IMAGE" | cut -f1))"
    [ -s "$PROMPT" ] && echo "prompt: $PROMPT"
}

# --- auto -----------------------------------------------------------------------
# Pill/keybind entrypoint: stage from clipboard if one is there, then build.
cmd_auto() {
    if [ -s "$IMAGE" ] && is_image "$IMAGE" && grep -q '"phase":"staged"\|"phase":"idle"\|"done"\|"error"' "$STATE" 2>/dev/null; then
        # image already staged — build directly, unless clipboard holds a NEW image
        if wl-paste -t image/png 2>/dev/null | cmp -s - "$IMAGE" >/dev/null 2>&1; then
            cmd_run
        fi
        # clipboard differs → re-stage then run
        if wl-paste -t image/png > "$IMAGE.tmp" 2>/dev/null && is_image "$IMAGE.tmp"; then
            mv -f "$IMAGE.tmp" "$IMAGE"
        fi
        cmd_run
    fi
    if wl-paste -t image/png > "$IMAGE.tmp" 2>/dev/null && is_image "$IMAGE.tmp" && [ -s "$IMAGE.tmp" ]; then
        mv -f "$IMAGE.tmp" "$IMAGE"
        set_state "staged" "attached from clipboard"
    fi
    cmd_run
}

case "${1:-status}" in
    stage)   cmd_stage "${2:-}" ;;
    auto)    cmd_auto ;;
    run)     cmd_run ;;
    status)  cmd_status ;;
    *) echo "usage: img-prompt {stage [file]|auto|run|status}"; exit 1 ;;
esac
