#!/usr/bin/env bash
# dns-switch — rootless DNS switcher for NetworkManager + Tailscale.
# Providers: google, cloudflare, quad9, magicdns (Tailscale), isp (DHCP default).
# Subcommands: status | current | providers | apply <provider> | cycle | test
set -u
export LC_ALL=C

STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dns-switch"
STATE_FILE="$STATE_DIR/state.json"
MAGIC_V4="100.100.100.100"
MAGIC_V6="fd7a:115c:a1e0::53"
# Static DNS must outrank DHCP-supplied servers from every other connection.
PRIORITY=100
LIBC_MAX_NS=3

ORDER=(google cloudflare quad9 magicdns isp)

declare -A LABEL SHORT ICON DESC V4S V6S
LABEL[google]="Google DNS";            SHORT[google]="Google"
DESC[google]="Google's public resolver. No filtering, anycast, heavily cached."
V4S[google]="8.8.8.8 8.8.4.4"
V6S[google]="2001:4860:4860::8888 2001:4860:4860::8844"
ICON[google]="language"

LABEL[cloudflare]="Cloudflare DNS";    SHORT[cloudflare]="Cloudflare"
DESC[cloudflare]="1.1.1.1 — fastest public resolver, does not log your IP address."
V4S[cloudflare]="1.1.1.1 1.0.0.1"
V6S[cloudflare]="2606:4700:4700::1111 2606:4700:4700::1001"
ICON[cloudflare]="cloud"

LABEL[quad9]="Quad9 DNS";              SHORT[quad9]="Quad9"
DESC[quad9]="Security-filtered resolver: blocks known-malicious domains, no logging."
V4S[quad9]="9.9.9.9 149.112.112.112"
V6S[quad9]="2620:fe::fe 2620:fe::9"
ICON[quad9]="shield"

LABEL[magicdns]="Tailscale MagicDNS";  SHORT[magicdns]="MagicDNS"
DESC[magicdns]="Tailnet resolver: resolves machine names and the .ts.net search domain."
V4S[magicdns]="$MAGIC_V4"
V6S[magicdns]="$MAGIC_V6"
ICON[magicdns]="vpn_key"

LABEL[isp]="ISP / Router (DHCP)";      SHORT[isp]="ISP"
DESC[isp]="Whatever the router hands out over DHCP. No overrides, MagicDNS off."
V4S[isp]="none"
V6S[isp]="none"
ICON[isp]="settings_ethernet"

WARNINGS=()
warn() { WARNINGS+=("$1"); }

# --- profiles / devices ------------------------------------------------------
# Only physical connections get static DNS: loopback, bridges and tailscale0
# would be noise, and VPNs bring their own resolver.
target_profiles() {
    local line name type
    while IFS= read -r line; do
        line=${line//\\:/:}          # nmcli escapes colons inside names
        type=${line##*:}
        name=${line%:*}
        case "$type" in
            ethernet | 802-3-ethernet | wifi | 802-11-wireless) printf '%s\n' "$name" ;;
        esac
    done < <(nmcli -t -f NAME,TYPE connection show 2>/dev/null)
}

active_target_devices() {
    local dev type state
    while IFS=: read -r dev type state; do
        [ "$state" = "connected" ] || continue
        case "$type" in
            ethernet | 802-3-ethernet | wifi | 802-11-wireless) printf '%s\n' "$dev" ;;
        esac
    done < <(nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null)
}

first_profile() { target_profiles | head -1; }

profile_field() { # $1 = nmcli field
    local name
    name=$(first_profile)
    [ -n "$name" ] || return 1
    nmcli -t -f "$1" connection show "$name" 2>/dev/null | cut -d: -f2-
}

norm() { # "8.8.8.8, 8.8.4.4" -> "8.8.8.8 8.8.4.4"
    local s=${1//,/ }
    s=$(printf '%s' "$s" | tr -s ' ')
    s=${s#"${s%%[![:space:]]*}"}
    s=${s%"${s##*[![:space:]]}"}
    printf '%s' "$s"
}

# --- tailscale DNS ownership -------------------------------------------------
tailscale_installed() { command -v tailscale >/dev/null 2>&1; }

tailscale_serving() { # true when /etc/resolv.conf carries Tailscale's DNS
    head -3 /etc/resolv.conf 2>/dev/null | grep -qi 'generated by tailscale' && return 0
    grep -q "^nameserver $MAGIC_V4\$" /etc/resolv.conf 2>/dev/null
}

tailscale_set_dns() { # $1 = true|false
    tailscale_installed || { warn "tailscale is not installed — MagicDNS mode unavailable"; return 0; }
    local out
    if ! out=$(tailscale set "--accept-dns=$1" 2>&1); then
        warn "tailscale set --accept-dns=$1 failed: ${out:-unknown error}"
        return 1
    fi
    return 0
}

# --- detection ---------------------------------------------------------------
detect_provider() {
    local v4 v6
    v4=$(norm "$(profile_field ipv4.dns)")
    v6=$(norm "$(profile_field ipv6.dns)")
    if [ -z "$v4" ]; then
        if tailscale_wants_dns; then printf 'magicdns'; else printf 'isp'; fi
        return 0
    fi
    local p
    for p in "${ORDER[@]}"; do
        case "$p" in
            magicdns | isp) continue ;;
        esac
        if [ "$(norm "${V4S[$p]}")" = "$v4" ] && [ "$(norm "${V6S[$p]}")" = "$v6" ]; then
            printf '%s' "$p"
            return 0
        fi
    done
    printf 'custom'
}

# --- applying ----------------------------------------------------------------
set_profile_dns() { # $1 = ipv4 list, $2 = ipv6 list, $3 = ignore-auto-dns (yes|no)
    local v4="$1" v6="$2" ignore="${3:-no}" priority=0
    local name failed=0
    [ "$ignore" = "yes" ] && priority=$PRIORITY
    while read -r name; do
        [ -n "$name" ] || continue
        if ! nmcli connection modify "$name" \
            ipv4.dns "$v4" ipv4.ignore-auto-dns "$ignore" ipv4.dns-priority "$priority" \
            ipv6.dns "$v6" ipv6.ignore-auto-dns "$ignore" ipv6.dns-priority "$priority" \
            >/dev/null 2>&1; then
            warn "nmcli rejected changes to profile '$name'"
            failed=1
        fi
    done < <(target_profiles)
    return $failed
}

reapply_devices() {
    nmcli connection reload >/dev/null 2>&1
    local dev
    while read -r dev; do
        [ -n "$dev" ] || continue
        nmcli device reapply "$dev" >/dev/null 2>&1 || warn "could not reapply device $dev"
    done < <(active_target_devices)
}

tailscale_wants_dns() { # the --accept-dns preference, readable without root
    tailscale_installed || return 1
    [ "$(tailscale debug prefs 2>/dev/null | jq -r '.CorpDNS // false')" = "true" ]
}

magicdns_suffix() {
    tailscale_installed || return 0
    tailscale status --json 2>/dev/null | jq -r '.MagicDNSSuffix // empty'
}

# NetworkManager rewrites /etc/resolv.conf asynchronously after a reapply.
wait_nm_resolv() {
    local i
    for i in $(seq 1 12); do
        grep -q 'Generated by NetworkManager' /etc/resolv.conf 2>/dev/null && return 0
        sleep 0.25
    done
    return 1
}

verify_effective() { # $1 = provider id
    local i
    for i in $(seq 1 16); do
        case "$1" in
            magicdns) tailscale_serving && return 0 ;;
            isp)      grep -q 'Generated by NetworkManager' /etc/resolv.conf 2>/dev/null &&
                      ! tailscale_serving && return 0 ;;
            *)        grep -q "^nameserver ${V4S[$1]%% *}$" /etc/resolv.conf 2>/dev/null && return 0 ;;
        esac
        sleep 0.25
    done
    return 1
}

apply_provider() {
    local id="$1"
    printf '%s\n' "${ORDER[@]}" | grep -qx "$id" || {
        echo "Unknown provider '$id'. Valid: ${ORDER[*]}" >&2
        return 2
    }
    local name
    name=$(first_profile)
    [ -n "$name" ] || { echo "No ethernet/wifi connection profile found." >&2; return 1; }

    case "$id" in
        magicdns)
            set_profile_dns "" "" no
            reapply_devices
            wait_nm_resolv
            # Tailscale must write resolv.conf last, otherwise a late
            # NetworkManager update clobbers MagicDNS. Toggling re-applies its
            # DNS even when --accept-dns is already on.
            tailscale_set_dns false
            tailscale_set_dns true
            ;;
        isp)
            tailscale_set_dns false
            set_profile_dns "" "" no
            reapply_devices
            ;;
        *)
            tailscale_set_dns false
            set_profile_dns "${V4S[$id]}" "${V6S[$id]}" yes
            reapply_devices
            ;;
    esac

    mkdir -p "$STATE_DIR"
    printf '{"provider":"%s","applied":%s}\n' "$id" "$(date +%s)" > "$STATE_FILE"

    if verify_effective "$id"; then
        :
    else
        warn "resolver has not picked up ${LABEL[$id]} yet — reconnect the link (nmcli device reapply) if this persists"
    fi

    local eff
    sleep 0.4   # NM may rewrite resolv.conf once more after dropping the old servers
    eff=$(awk '/^[[:space:]]*nameserver/ {printf "%s ", $2}' /etc/resolv.conf)
    echo "DNS provider: ${LABEL[$id]} (${SHORT[$id]})"
    echo "Profiles updated: $(target_profiles | paste -sd', ' -)"
    if [ "$id" != "magicdns" ] && [ "$id" != "isp" ]; then
        echo "IPv4: ${V4S[$id]}"
        echo "IPv6: ${V6S[$id]}"
    fi
    echo "Active nameservers: ${eff:-none}"
    if [ "${#WARNINGS[@]}" -gt 0 ]; then
        printf 'Warning: %s\n' "${WARNINGS[@]}" >&2
    fi
    return 0
}

cycle_provider() {
    local cur next i
    cur=$(detect_provider)
    for i in "${!ORDER[@]}"; do
        if [ "${ORDER[$i]}" = "$cur" ]; then
            next=${ORDER[(( (i + 1) % ${#ORDER[@]} ))]}
            apply_provider "$next"
            return $?
        fi
    done
    apply_provider google
}

# --- JSON output -------------------------------------------------------------
json_array() { printf '%s\n' "$@" | jq -R . | jq -sc .; }

providers_json() {
    local p out=()
    for p in "${ORDER[@]}"; do
        out+=("$(jq -nc \
            --arg id "$p" \
            --arg label "${LABEL[$p]}" \
            --arg short "${SHORT[$p]}" \
            --arg icon "${ICON[$p]}" \
            --arg desc "${DESC[$p]}" \
            --arg v4 "${V4S[$p]}" \
            --arg v6 "${V6S[$p]}" \
            '{id:$id,label:$label,short:$short,icon:$icon,desc:$desc,
              ipv4: (if $v4=="none" then [] else ($v4|split(" ")) end),
              ipv6: (if $v6=="none" then [] else ($v6|split(" ")) end)}')")
    done
    printf '%s\n' "${out[@]}" | jq -sc .
}

status_json() {
    local id effective search v4 v6 state_provider drift warnjson
    local lbl shrt icn dsc
    id=$(detect_provider)
    v4=$(profile_field ipv4.dns)
    v6=$(profile_field ipv6.dns)
    mapfile -t effective < <(awk '/^[[:space:]]*nameserver/ {print $2}' /etc/resolv.conf 2>/dev/null)
    search=$(awk '/^[[:space:]]*search/ {$1=""; sub(/^[ \t]+/, ""); print}' /etc/resolv.conf 2>/dev/null)
    state_provider=$(jq -r '.provider // empty' "$STATE_FILE" 2>/dev/null)
    drift=false
    [ -n "$state_provider" ] && [ "$state_provider" != "$id" ] && drift=true

    if [ "$id" = "custom" ]; then
        lbl="Custom DNS"; shrt="Custom"; icn="dns"
        dsc="Static DNS that does not match a bundled provider"
    else
        lbl="${LABEL[$id]}"; shrt="${SHORT[$id]}"; icn="${ICON[$id]}"; dsc="${DESC[$id]}"
    fi

    warnjson='[]'
    if [ "${#WARNINGS[@]}" -gt 0 ]; then
        warnjson=$(printf '%s\n' "${WARNINGS[@]}" | jq -R . | jq -sc .)
    fi

    jq -nc \
        --arg provider "$id" \
        --arg label "$lbl" \
        --arg short "$shrt" \
        --arg icon "$icn" \
        --arg desc "$dsc" \
        --arg ipv4 "$(norm "$v4")" \
        --arg ipv6 "$(norm "$v6")" \
        --arg search "$search" \
        --arg desired "$state_provider" \
        --argjson drift "$drift" \
        --argjson tailscale "$(tailscale_serving && echo true || echo false)" \
        --argjson tailscale_wanted "$(tailscale_wants_dns && echo true || echo false)" \
        --arg magicdns_suffix "$(magicdns_suffix)" \
        --argjson tailscale_installed "$(tailscale_installed && echo true || echo false)" \
        --argjson profiles "$(target_profiles | jq -R . | jq -sc .)" \
        --argjson devices "$(active_target_devices | jq -R . | jq -sc .)" \
        --argjson effective "$(json_array "${effective[@]}")" \
        --argjson providers "$(providers_json)" \
        --argjson warnings "$warnjson" \
        --argjson libc_max "$LIBC_MAX_NS" \
        '{provider:$provider,label:$label,short:$short,icon:$icon,desc:$desc,
          ipv4: (if $ipv4=="" then [] else ($ipv4|split(" ")) end),
          ipv6: (if $ipv6=="" then [] else ($ipv6|split(" ")) end),
          search:$search, desired:$desired, drift:$drift,
          tailscale_dns:$tailscale, tailscale_wanted:$tailscale_wanted,
          tailscale_installed:$tailscale_installed,
          magicdns_suffix:$magicdns_suffix,
          magicdns_pending: ($tailscale_wanted and ($tailscale|not)),
          profiles:$profiles, devices:$devices, effective:$effective,
          effective_ignored: (if ($effective|length) > $libc_max then ($effective[$libc_max:]) else [] end),
          providers:$providers,
          warnings:$warnings}'
}

probe_prog='
import json, socket, struct, sys, time
families = {"ipv4": socket.AF_INET, "ipv6": socket.AF_INET6}
tid = 0x1000
results = []
for entry in json.loads(sys.stdin.read()):
    tid += 1
    pkt = struct.pack(">HHHHHH", tid, 0x0100, 1, 0, 0, 0)
    for label in "example.com".split("."):
        pkt += bytes([len(label)]) + label.encode()
    pkt += b"\x00" + struct.pack(">HH", 1, 1)
    out = {"provider": entry["provider"], "ip": entry["ip"], "family": entry["family"],
           "ms": None, "error": None}
    sock = socket.socket(families[entry["family"]], socket.SOCK_DGRAM)
    sock.settimeout(1.2)
    started = time.monotonic()
    try:
        sock.connect((entry["ip"], 53))
        sock.send(pkt)
        sock.recv(512)
        out["ms"] = round((time.monotonic() - started) * 1000)
    except Exception as exc:
        out["error"] = type(exc).__name__
    finally:
        sock.close()
    results.append(out)
print(json.dumps(results, separators=(",", ":")))
'

test_json() {
    # Servers come from the provider table, so the IPs live in exactly one place.
    providers_json | jq -c '[ .[] as $p
        | ( $p.ipv4[] | {provider: $p.id, ip: ., family: "ipv4"} ),
          ( $p.ipv6[] | {provider: $p.id, ip: ., family: "ipv6"} ) ]' |
        python3 -I -P -c "$probe_prog"
}

usage() {
    cat <<EOF
dns-switch — switch DNS provider (rootless, NetworkManager + Tailscale)

Usage:
  dns-switch status               current state as JSON
  dns-switch current              active provider id only
  dns-switch providers            provider catalogue as JSON
  dns-switch apply <provider>     apply a provider
  dns-switch cycle                go to the next provider
  dns-switch test                 probe latency of every nameserver (JSON)

Providers: ${ORDER[*]}
EOF
}

main() {
    case "${1:-status}" in
        status)   status_json ;;
        current)  detect_provider; printf '\n' ;;
        providers) providers_json ;;
        apply)    apply_provider "${2:-}" ;;
        cycle)    cycle_provider ;;
        test)     test_json ;;
        help|-h|--help) usage ;;
        *)        usage >&2; exit 2 ;;
    esac
}

main "$@"
