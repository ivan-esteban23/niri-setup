#!/usr/bin/env python3
"""
Universal Media Thumbnail & Artist Resolver for DankMaterialShell / MPRIS.
Given a track title, artist, and album (e.g. from Bandcamp, YouTube, Spotify,
SoundCloud, or any website), resolves a high-resolution thumbnail image and
clean artist/title metadata, caching locally for instant load.
"""

import hashlib
import json
import os
import re
import sys
import urllib.parse
import urllib.request
from pathlib import Path

CACHE_DIR = Path.home() / ".cache" / "DankMaterialShell" / "imagecache"

# Known browser placeholder icon SHA1 hashes (Chrome, Brave Origin, Chromium, etc.)
PLACEHOLDER_SHA1S = {
    "764a730860c5b8a7bbee690ee5a443672ae37dc8",  # Google Chrome
    "1a0e138f1c6817d0b68f43d4ff3f8ba64b2ce001",  # Brave Origin 256x256
}


def sha1_file(path: str) -> str:
    try:
        p = Path(path.replace("file://", ""))
        if p.is_file():
            return hashlib.sha1(p.read_bytes()).hexdigest()
    except Exception:
        pass
    return ""


def clean_query(raw_title: str, raw_artist: str, raw_album: str) -> tuple[str, str, str]:
    title = (raw_title or "").strip()
    artist = (raw_artist or "").strip()
    album = (raw_album or "").strip()

    # Strip leading play/pause triangles often added by Bandcamp/YouTube/SoundCloud tab titles
    title = re.sub(r"^[▶⏸🔊🔉🔈►•\-\s]+", "", title).strip()
    # Strip trailing site names
    title = re.sub(
        r"\s*[\|\-—]\s*(YouTube|YouTube Music|Spotify|Bandcamp|SoundCloud|Twitch|Vimeo)$",
        "",
        title,
        flags=re.IGNORECASE,
    ).strip()

    # Bandcamp format: "Track/Album | Artist"
    if "|" in title and not artist:
        parts = [p.strip() for p in title.split("|") if p.strip()]
        if len(parts) >= 2:
            title = parts[0]
            artist = parts[1]

    # Common YouTube/SoundCloud format: "Artist - Title"
    elif " - " in title and not artist:
        parts = [p.strip() for p in title.split(" - ", 1)]
        if len(parts) == 2:
            artist, title = parts[0], parts[1]
    elif " — " in title and not artist:
        parts = [p.strip() for p in title.split(" — ", 1)]
        if len(parts) == 2:
            artist, title = parts[0], parts[1]

    # Clean noise like "(Official Video)", "[Full Album]", "(HD)", etc. for search query
    clean_title = re.sub(
        r"\s*[\(\[](Official[^)\]]*|Music Video|Lyric[^)\]]*|Audio|Full Album|HD|4K|Visualizer|Live[^)\]]*)[\)\]]",
        "",
        title,
        flags=re.IGNORECASE,
    ).strip()

    return clean_title or title, artist, album


def http_get_json(url: str, timeout: float = 4.0) -> dict | list | None:
    try:
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) DMSMediaThumbnail/1.0"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8", errors="replace"))
    except Exception:
        return None


def http_download(url: str, dest: Path, timeout: float = 6.0) -> bool:
    try:
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) DMSMediaThumbnail/1.0"},
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = resp.read()
            if len(data) > 1024:
                tmp = dest.with_suffix(".tmp")
                tmp.write_bytes(data)
                tmp.replace(dest)
                return True
    except Exception:
        pass
    return False


def search_itunes(query: str) -> tuple[str, str, str]:
    q = urllib.parse.quote(query)
    for entity in ("song", "album"):
        data = http_get_json(f"https://itunes.apple.com/search?term={q}&entity={entity}&limit=3")
        if isinstance(data, dict) and data.get("results"):
            item = data["results"][0]
            art = item.get("artworkUrl100", "")
            if art:
                art_hi = art.replace("100x100bb", "600x600bb")
                found_artist = item.get("artistName", "")
                found_title = item.get("trackName") or item.get("collectionName") or ""
                return art_hi, found_artist, found_title
    return "", "", ""


def search_deezer(query: str) -> tuple[str, str, str]:
    q = urllib.parse.quote(query)
    data = http_get_json(f"https://api.deezer.com/search?q={q}&limit=3")
    if isinstance(data, dict) and data.get("data"):
        item = data["data"][0]
        album_obj = item.get("album") or {}
        art = album_obj.get("cover_big") or album_obj.get("cover_xl") or album_obj.get("cover_medium") or ""
        artist_obj = item.get("artist") or {}
        return art, artist_obj.get("name", ""), item.get("title", "")
    return "", "", ""


def search_yt_thumbnail(query: str) -> str:
    """Fallback: search YouTube / Piped for any video/music query to grab its thumbnail."""
    q = urllib.parse.quote(query)
    try:
        req = urllib.request.Request(
            f"https://www.youtube.com/results?search_query={q}",
            headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36"},
        )
        with urllib.request.urlopen(req, timeout=4.5) as resp:
            html = resp.read().decode("utf-8", errors="ignore")
        m = re.search(r'"videoId":"([a-zA-Z0-9_-]{11})"', html)
        if m:
            vid = m.group(1)
            return f"https://i.ytimg.com/vi/{vid}/hqdefault.jpg"
    except Exception:
        pass
    return ""


def main() -> int:
    raw_title = sys.argv[1] if len(sys.argv) > 1 else ""
    raw_artist = sys.argv[2] if len(sys.argv) > 2 else ""
    raw_album = sys.argv[3] if len(sys.argv) > 3 else ""
    current_art = sys.argv[4] if len(sys.argv) > 4 else ""

    if not raw_title and not raw_artist:
        return 1

    # Check if current_art is already a valid non-placeholder image
    if current_art:
        sha = sha1_file(current_art)
        if sha and sha not in PLACEHOLDER_SHA1S and "enhanced_" in current_art:
            print(json.dumps({"artUrl": current_art, "title": raw_title, "artist": raw_artist}))
            return 0

    title, artist, album = clean_query(raw_title, raw_artist, raw_album)
    query = f"{artist} {title}".strip() if artist else title
    if not query:
        return 1

    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    key_hash = hashlib.sha1(query.lower().encode("utf-8")).hexdigest()[:16]
    dest_file = CACHE_DIR / f"enhanced_{key_hash}.jpg"
    meta_file = CACHE_DIR / f"enhanced_{key_hash}.json"

    if dest_file.is_file() and dest_file.stat().st_size > 1024:
        saved_meta = {"artUrl": f"file://{dest_file}", "title": title, "artist": artist}
        if meta_file.is_file():
            try:
                saved_meta = json.loads(meta_file.read_text(encoding="utf-8"))
            except Exception:
                pass
        print(json.dumps(saved_meta))
        return 0

    art_url, found_artist, found_title = search_deezer(query)
    if not art_url:
        art_url, found_artist, found_title = search_itunes(query)
    if not art_url and title:
        art_url, found_artist, found_title = search_deezer(title)
    if not art_url:
        art_url = search_yt_thumbnail(query)

    if art_url and http_download(art_url, dest_file):
        final_artist = artist or found_artist
        final_title = title or found_title or raw_title
        result = {
            "artUrl": f"file://{dest_file}",
            "title": final_title,
            "artist": final_artist,
        }
        meta_file.write_text(json.dumps(result), encoding="utf-8")
        print(json.dumps(result))
        return 0

    return 1


if __name__ == "__main__":
    sys.exit(main())
