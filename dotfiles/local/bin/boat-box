#!/usr/bin/env bash
# boat-box — Helper tool for managing user's Boat Sandboxes
#   • The Reference Edit: bx_4qhc25xp (default dir: Work/the-reference-edit)
#   • Portrait Issue 02:  bx_wbqyt3bf (default dir: Work/the-portrait-edit-issue-02)
set -euo pipefail

BOX_REF="bx_4qhc25xp"
BOX_PORTRAIT="bx_wbqyt3bf"

usage() {
    cat <<EOF
boat-box — Manage Boat Sandboxes (The Reference Edit & Portrait Issue 02)

Usage:
  boat-box status                      Show status of all sandboxes
  boat-box start <ref|portrait>        Start / Resume a sandbox
  boat-box stop <ref|portrait>         Stop sandbox to pause billing
  boat-box build <ref|portrait>        Run 'npm run build' in project dir
  boat-box test <ref|portrait>         Run 'npm test' in project dir
  boat-box pr <ref|portrait> [args..]  Run 'gh pr' (list, view, diff, create, merge)
  boat-box exec <ref|portrait> <cmd..> Run command in project dir (or use --home for ~)
  boat-box ssh <ref|portrait> [cmd..]  Open interactive SSH or run remote command
  boat-box prompt <ref|portrait> <txt> Send prompt to coding agent in sandbox
  boat-box forward <ref|portrait> <remote_port> [local_port] Forward a TCP port
  boat-box info <ref|portrait>         Show detailed sandbox info
  boat-box desktop <ref|portrait>      Get/open sandbox web desktop URL

Aliases & Default Directories:
  ref      -> bx_4qhc25xp (cwd: Work/the-reference-edit)
  portrait -> bx_wbqyt3bf (cwd: Work/the-portrait-edit-issue-02)
EOF
}

resolve_id() {
    case "${1:-}" in
        ref|reference|the-reference-edit|bx_4qhc25xp) echo "$BOX_REF" ;;
        portrait|portrait-02|issue-02|bx_wbqyt3bf) echo "$BOX_PORTRAIT" ;;
        *) echo "${1:-}" ;;
    esac
}

resolve_dir() {
    case "${1:-}" in
        ref|reference|the-reference-edit|bx_4qhc25xp) echo "Work/the-reference-edit" ;;
        portrait|portrait-02|issue-02|bx_wbqyt3bf) echo "Work/the-portrait-edit-issue-02" ;;
        *) echo "" ;;
    esac
}

CMD="${1:-}"
shift || { usage; exit 1; }

case "$CMD" in
    status|list)
        boat list --all
        ;;
    start|resume)
        ID="$(resolve_id "${1:-}")"
        echo "Starting Boat sandbox $ID..."
        boat resume "$ID"
        ;;
    stop)
        ID="$(resolve_id "${1:-}")"
        echo "Stopping Boat sandbox $ID..."
        boat stop "$ID"
        ;;
    info)
        ID="$(resolve_id "${1:-}")"
        boat info "$ID"
        ;;
    build)
        RAW_TARGET="${1:-}"
        ID="$(resolve_id "$RAW_TARGET")"
        DEFAULT_DIR="$(resolve_dir "$RAW_TARGET")"
        shift || true
        echo "Building $RAW_TARGET ($ID)..."
        if [ -n "$DEFAULT_DIR" ]; then
            boat exec "$ID" --cwd "$DEFAULT_DIR" npm run build "$@"
        else
            boat exec "$ID" npm run build "$@"
        fi
        ;;
    test)
        RAW_TARGET="${1:-}"
        ID="$(resolve_id "$RAW_TARGET")"
        DEFAULT_DIR="$(resolve_dir "$RAW_TARGET")"
        shift || true
        echo "Running tests in $RAW_TARGET ($ID)..."
        if [ -n "$DEFAULT_DIR" ]; then
            boat exec "$ID" --cwd "$DEFAULT_DIR" npm test "$@"
        else
            boat exec "$ID" npm test "$@"
        fi
        ;;
    pr)
        RAW_TARGET="${1:-}"
        ID="$(resolve_id "$RAW_TARGET")"
        DEFAULT_DIR="$(resolve_dir "$RAW_TARGET")"
        shift || true
        if [ $# -eq 0 ]; then
            if [ -n "$DEFAULT_DIR" ]; then
                boat exec "$ID" --cwd "$DEFAULT_DIR" gh pr list
            else
                boat exec "$ID" gh pr list
            fi
        else
            if [ -n "$DEFAULT_DIR" ]; then
                boat exec "$ID" --cwd "$DEFAULT_DIR" gh pr "$@"
            else
                boat exec "$ID" gh pr "$@"
            fi
        fi
        ;;
    exec)
        RAW_TARGET="${1:-}"
        ID="$(resolve_id "$RAW_TARGET")"
        DEFAULT_DIR="$(resolve_dir "$RAW_TARGET")"
        shift
        if [ "${1:-}" = "--home" ]; then
            shift
            boat exec "$ID" "$@"
        elif [ -n "$DEFAULT_DIR" ]; then
            boat exec "$ID" --cwd "$DEFAULT_DIR" "$@"
        else
            boat exec "$ID" "$@"
        fi
        ;;
    ssh)
        ID="$(resolve_id "${1:-}")"
        shift || true
        boat ssh "$ID" "$@"
        ;;
    prompt)
        ID="$(resolve_id "${1:-}")"
        shift
        boat prompt "$ID" "$@"
        ;;
    forward)
        ID="$(resolve_id "${1:-}")"
        REMOTE="${2:-3000}"
        LOCAL="${3:-$REMOTE}"
        boat forward "$ID" --remote "$REMOTE" --local "$LOCAL"
        ;;
    desktop)
        ID="$(resolve_id "${1:-}")"
        boat desktop "$ID"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Unknown command: $CMD" >&2
        usage >&2
        exit 1
        ;;
esac
