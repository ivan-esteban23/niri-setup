{
  "$schema": "https://opencode.ai/config.json",
  "model": {
    "providerID": "openai",
    "model": "gpt-6.1-terra",
    "variant": "medium"
  },
  "instructions": [
    "~/.config/opencode/AGENTS.md"
  ],
  "skills": [
    "~/.config/opencode/skills"
  ],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "allow" },
    { "action": "read", "resource": "*.env.*", "effect": "allow" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "tavily": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "tavily-mcp"
        ],
        "environment": {
          "TAVILY_API_KEY": "__TAVILY_API_KEY__"
        }
      }
    }
  },
  "providers": {
    "experientiallabs": {
      "name": "Experiential Labs",
      "env": [
        "EXPERIENTIALLABS_API_KEY",
        "EXPLABS_API_KEY"
      ],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://api.experientiallabs.ai/v1"
      },
      "headers": {
        "Authorization": "Bearer __EXPERIENTIALLABS_API_KEY__"
      },
      "models": {
        "glm-5.3-uncensored": {
          "name": "GLM 5.3 Uncensored 1M",
          "limit": {
            "context": 1048576,
            "input": 1048576,
            "output": 131072
          }
        },
        "glm-5.3-flash-uncensored": {
          "name": "GLM 5.3 Flash Uncensored 1M",
          "limit": {
            "context": 1048576,
            "input": 1048576,
            "output": 131072
          }
        }
      }
    }
  }
}
