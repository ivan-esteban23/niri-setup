[Unit]
Description=ydotoold — virtual input for ydotool (socket confined to the runtime dir)
Documentation=man:ydotoold(8)
PartOf=niri.service
After=niri.service

[Service]
Type=simple
ExecStart=/usr/bin/ydotoold --socket-path=%t/ydotool.sock --socket-perm=0600
Restart=on-failure
RestartSec=3

[Install]
WantedBy=niri.service
